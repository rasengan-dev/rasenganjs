# Algolia DocSearch (client-exposed, RASENGAN_ prefix required)
# Filled in once the DocSearch application (https://docsearch.algolia.com)
# is approved. The API key here is the public, search-only key DocSearch
# issues, safe to expose in the client bundle.
RASENGAN_ALGOLIA_APP_ID=
RASENGAN_ALGOLIA_API_KEY=
RASENGAN_ALGOLIA_INDEX_NAME=
