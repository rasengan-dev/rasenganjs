{
  "name": "@rasenganjs/cloudflare",
  "version": "1.0.0-beta.1",
  "type": "module",
  "description": "Cloudflare Workers adapter to serve Rasengan apps on Cloudflare",
  "bugs": {
    "url": "https://github.com/rasengan-dev/rasenganjs/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rasengan-dev/rasenganjs",
    "directory": "packages/deploy/cloudflare"
  },
  "license": "MIT",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:clean": "rimraf ./dist",
    "build": "pnpm run build:clean && tsup",
    "deploy": "pnpm publish --access public",
    "deploy:beta": "pnpm run deploy --tag beta",
    "pack": "pnpm pack --pack-destination ./release/"
  },
  "peerDependencies": {
    "rasengan": "workspace:^"
  },
  "files": [
    "dist/",
    "CHANGELOG.md",
    "LICENSE.md",
    "README.md"
  ],
  "dependencies": {
    "esbuild": "^0.28.1"
  }
}
