{
  "name": "@rasenganjs/runtime",
  "version": "1.0.0",
  "description": "WinterCG-compatible runtime abstraction layer for Rasengan.JS — middleware pipeline, router, and request/response utilities",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rasengan-dev/rasenganjs",
    "directory": "packages/rasengan-runtime"
  },
  "scripts": {
    "build:clean": "rimraf ./dist",
    "build": "pnpm build:clean && tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "npx tsx src/__benchmarks__/router.bench.ts",
    "pack": "pnpm pack --pack-destination ./release",
    "deploy": "pnpm publish --access public",
    "deploy:beta": "pnpm run deploy --tag beta"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.9",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "files": [
    "dist/",
    "CHANGELOG.md",
    "LICENSE.md",
    "README.md"
  ]
}
