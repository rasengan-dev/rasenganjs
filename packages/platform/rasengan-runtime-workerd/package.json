{
  "name": "@rasenganjs/runtime-workerd",
  "version": "1.0.0",
  "description": "[DEPRECATED] Use @rasenganjs/runtime instead. workerd RuntimeAdapter for Rasengan.JS — fetch event registration, no local FS (KV/R2-friendly)",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rasengan-dev/rasenganjs",
    "directory": "packages/rasengan-runtime-workerd"
  },
  "scripts": {
    "build:clean": "rimraf ./dist",
    "build": "pnpm build:clean && tsup",
    "pack": "pnpm pack --pack-destination ./release",
    "deploy": "pnpm publish --access public",
    "deploy:beta": "pnpm run deploy --tag beta"
  },
  "peerDependencies": {
    "@rasenganjs/runtime": "workspace:*"
  },
  "devDependencies": {
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist/",
    "CHANGELOG.md",
    "LICENSE.md",
    "README.md"
  ]
}
