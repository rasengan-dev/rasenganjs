{
  "name": "@rasenganjs/drizzle",
  "version": "1.0.0-beta.1",
  "description": "Drizzle ORM integration for Rasengan Server — DataSource provider + DrizzleModule.forRoot(), driver-agnostic via a small adapter interface.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rasengan-dev/rasenganjs",
    "directory": "packages/ecosystem/drizzle"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./drivers/node-postgres": {
      "types": "./dist/drivers/node-postgres.d.ts",
      "import": "./dist/drivers/node-postgres.js",
      "require": "./dist/drivers/node-postgres.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:clean": "rimraf ./dist",
    "build": "pnpm build:clean && tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pack": "pnpm pack --pack-destination ./release"
  },
  "peerDependencies": {
    "@rasenganjs/server": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rasenganjs/server": "workspace:*",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.9",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "files": [
    "dist/",
    "CHANGELOG.md",
    "LICENSE.md",
    "README.md"
  ]
}
