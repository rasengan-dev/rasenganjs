{
  "name": "@rasenganjs/openapi",
  "version": "0.2.0",
  "description": "OpenAPI 3.1 generation + Scalar/Swagger docs UI. Futon-native core (@rasenganjs/openapi/futon), no DI/Module required, with a thin Rasengan Server adapter (@rasenganjs/openapi/server) — OpenApiModule.forRoot() + DI-injected OpenApiRegistry — built on top of it.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rasengan-dev/rasenganjs",
    "directory": "packages/ecosystem/openapi"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./futon": {
      "types": "./dist/futon.d.ts",
      "import": "./dist/futon.js",
      "require": "./dist/futon.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:clean": "rimraf ./dist",
    "build": "pnpm build:clean && tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pack": "pnpm pack --pack-destination ./release",
    "deploy": "pnpm publish --access public",
    "deploy:beta": "pnpm run deploy --tag beta"
  },
  "peerDependencies": {
    "@rasenganjs/futon": "workspace:*",
    "@rasenganjs/server": "workspace:*",
    "@rasenganjs/validators": "workspace:*",
    "zod": "^3.24.0"
  },
  "peerDependenciesMeta": {
    "@rasenganjs/futon": {
      "optional": true
    },
    "@rasenganjs/server": {
      "optional": true
    },
    "@rasenganjs/validators": {
      "optional": true
    }
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "openapi3-ts": "^4.6.1"
  },
  "devDependencies": {
    "@rasenganjs/futon": "workspace:*",
    "@rasenganjs/server": "workspace:*",
    "@rasenganjs/validators": "workspace:*",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.9",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9",
    "zod": "^3.24.0"
  },
  "files": [
    "dist/",
    "CHANGELOG.md",
    "LICENSE.md",
    "README.md"
  ]
}
