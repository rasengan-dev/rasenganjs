{
  "name": "@rasenganjs/ws",
  "version": "0.1.0",
  "description": "NestJS-inspired WebSocket Gateways for Rasengan Server — module-native registration, rooms, broadcasting, and pluggable storage (in-memory or Redis), built on RFC-0001's runtime-agnostic app.websocket().",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rasengan-dev/rasenganjs",
    "directory": "packages/ecosystem/ws"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:clean": "rimraf ./dist",
    "build": "pnpm build:clean && tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pack": "pnpm pack --pack-destination ./release"
  },
  "dependencies": {
    "@rasenganjs/server": "workspace:*"
  },
  "peerDependencies": {
    "ioredis": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rasenganjs/runtime": "workspace:*",
    "ioredis": "^5.0.0",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9",
    "@vitest/coverage-v8": "^4.1.9",
    "ws": "^8.21.0",
    "@types/ws": "^8.18.1"
  },
  "files": [
    "dist/",
    "CHANGELOG.md",
    "LICENSE.md",
    "README.md"
  ]
}
