{
  "name": "@rasenganjs/image",
  "private": false,
  "version": "1.1.3",
  "description": "Image component provided by RasenganJS to display images with ease",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./css": "./dist/styles/index.css"
  },
  "author": {
    "name": "dilane3",
    "email": "komboudilane125@gmail.com",
    "url": "https://dilane3.com",
    "twitter": "https://twitter.com/dilanekombou",
    "github": "https://github.com/dilane3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rasengan-dev/rasenganjs",
    "directory": "packages/ecosystem/image"
  },
  "license": "MIT",
  "scripts": {
    "build:clean": "rimraf ./dist",
    "copy:styles": "npx ncp src/styles dist/styles",
    "build": "pnpm run build:clean && tsup && pnpm run copy:styles",
    "pack": "pnpm pack --pack-destination ./release",
    "deploy": "pnpm publish --access public"
  },
  "peerDependencies": {
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "ncp": "^2.0.0",
    "tsup": "^8.5.1"
  }
}
